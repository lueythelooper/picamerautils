#!/bin/bash

if command -v rpicam-vid &> /dev/null; then
    echo ""
else
    echo "ERROR: Install rpicam-vid on this machine"
    exit -1
fi

WIDTH=640
HEIGHT=480
FRAMERATE=20

rpicam-vid -t 0 \
   --gain 2.0 \
   --width $WIDTH --height $HEIGHT --codec=h264 \
   --framerate $FRAMERATE --denoise cdn_off \
   -n --inline -o - | python3 /usr/share/picamproject/flask_server.py $WIDTH $HEIGHT
